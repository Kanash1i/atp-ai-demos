<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.atp</groupId>
    <artifactId>atp-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>atp-platform-api</artifactId>
  <name>ATP Platform API</name>
  <description>传统平台功能：项目/模块/案例、派发、执行记录、审批。持久层也在这里</description>

  <dependencies>
    <dependency>
      <groupId>com.atp</groupId>
      <artifactId>atp-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>druid-spring-boot-3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <!-- 执行队列。⚠️ Redis 只做「有新任务了」的通知，任务状态的真相在 PG ——
         理由见 ExecutionQueue 的类注释 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!--
      ⚠️ 没有它的话，application.yml 里的 lettuce.pool 配置**被静默忽略** ——
      Lettuce 退回 shareNativeConnection，所有 Redis 命令挤同一条连接。

      实测后果：节点上有两个线程常驻 BRPOP（执行队列 + 探查队列）再加心跳，
      互相阻塞导致「Redis command timed out」，探查功能整体不可用 ——
      而配置文件看起来完全正常，日志里也只有一个语焉不详的超时。

      spring-boot-starter-data-redis 不传递它（optional），必须显式声明。
      放在这里而不是各模块各加一份：依赖它的 atp-web / atp-runner / atp-agent 都能拿到。
    -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>
  </dependencies>
</project>
