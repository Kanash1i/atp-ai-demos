# ============================================================
#  复制本文件为 .env，填入真实值。.env 已被 .gitignore 忽略。
#     cp .env.example .env
#  两个 demo 都从仓库根目录的 .env 读取配置。
# ============================================================


# ─────────────────────────────────────────────
#  1. LLM —— 生成 / 字段补全  (demo1 + demo2 都用)
# ─────────────────────────────────────────────
# ⚠️ API KEY 填在这里 ↓↓↓
LLM_API_KEY=

# 开发期用 DeepSeek（便宜），后期可切 Kimi。两者都是 OpenAI 兼容格式，
# 切换只需要改下面三行，不需要改代码。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# 切到 Kimi 时改成：
#   LLM_PROVIDER=kimi
#   LLM_BASE_URL=https://api.moonshot.cn/v1     # 国际站为 https://api.moonshot.ai/v1，按你的账号所在地填
#   LLM_MODEL=kimi-k3                            # ⚠️ 确切 model 名请以控制台为准

# 结构化输出策略。⚠️ 两家能力不对等，见 02-HANDOFF §3-L3：
#   json_object   —— 最低公分母，DeepSeek 只支持这个。**默认值，最安全**
#   native_schema —— response_format: json_schema + strict，Kimi K3 / OpenAI 支持
#   auto          —— 按 LLM_PROVIDER 自动选最强可用策略
# 无论选哪个，本地 JSON Schema 校验都会执行，不会跳过。
LLM_STRUCTURED_MODE=json_object

# DeepSeek V4 默认开启 thinking 模式（更慢更贵，且响应含 reasoning 字段）。
# 规范化是确定性任务，不需要长推理，建议关掉。
LLM_THINKING=false
LLM_TEMPERATURE=0


# ─────────────────────────────────────────────
#  2. 服务机（局域网台式机 9800X3D / RTX 5080）
#     ⚠️ 只有 demo1 需要。demo2 只用 LLM，可以独立开发。
# ─────────────────────────────────────────────
# ⚠️ 填入台式机的局域网 IP ↓↓↓
# ─────────────────────────────────────────────────────────────
# ATP 平台数据库（demo2 CLI 写入案例）
# ─────────────────────────────────────────────────────────────
# ⚠️ CLI 取不到这几个变量会直接 fail fast，不给默认值 ——
#    默认值会把"配置漏了"变成"连到了错的库"，后者难查得多。
# atp inspect 用它打平台的探查接口。⭐ inspect 是唯一不碰数据库的命令，
# 只要这一个变量 —— 它是「agent 那一层不该看到 DB 密码」方向上第一个做到的。
ATP_API_URL=http://localhost:8080

ATP_DB_URL=jdbc:postgresql://127.0.0.1:5432/atp
ATP_DB_USER=atp
ATP_DB_PASSWORD=

SERVICE_HOST=

# SSH（免密配好后填，用于远程管理模型服务）
SERVICE_SSH_USER=
SERVICE_SSH_PORT=22


# ─────────────────────────────────────────────
#  3. Embedding —— bge-m3  (demo1)
#     TEI 容器 tei-embed（端点 /embed 与 OpenAI 兼容的 /v1/embeddings）
# ─────────────────────────────────────────────
EMBEDDING_BASE_URL=http://${SERVICE_HOST}:8081
EMBEDDING_MODEL=bge-m3
# bge-m3 输出维度固定 1024，必须与 Qdrant collection 维度一致
EMBEDDING_DIM=1024


# ─────────────────────────────────────────────
#  4. Rerank —— bge-reranker-v2-m3  (demo1)
#     TEI 容器 tei-rerank（端点 /rerank，字段是 texts 不是 documents）
# ─────────────────────────────────────────────
RERANK_BASE_URL=http://${SERVICE_HOST}:8082
RERANK_MODEL=bge-reranker-v2-m3
# ⚠️ 已实测可用：区分度达 4 个数量级。换模型后必须重跑 §2.1(e) 冒烟测试
RERANK_ENABLED=true

# 精排后的截断阈值。⚠️ 必须用**相对** top1 的比例，不能用绝对值 ——
# reranker 对「自然语言 query vs 结构化步骤序列」打分天然偏低：
# 实测文档类查询 top1 落在 0.59~0.99，案例类只有 0.008~0.38，差 1~2 个数量级。
# 曾用绝对阈值 0.01，结果「有没有涉及文件上传的案例」被整片砍成 0 条召回，
# 且不报错。详见 DECISIONS.md D-013。
RERANK_RELATIVE_FLOOR=0.02
# 绝对下限，只用来挡分数趋近 0 的纯噪音
RERANK_MIN_SCORE=0.0005


# ─────────────────────────────────────────────
#  4b. VLM —— 图片转文字描述  (demo1，可选)
# ─────────────────────────────────────────────
# 文档里的截图要转成文字才能落进向量库（bge-m3 是纯文本模型）。
# 留空则降级成「alt 文本 + 文件名关键词」，不影响入库。
#
# ⚠️ 合规：图片以 base64 进请求体。用云端 VLM 等于内部文档截图出网，
#    截图里可能有账号、内网地址、业务数据 —— 应优先本地部署，例如：
#      docker run -d --gpus all -p 8083:8000 vllm/vllm-openai \
#        --model Qwen/Qwen2.5-VL-3B-Instruct
#    然后填 ATP_VLM_BASE_URL=http://${SERVICE_HOST}:8083
ATP_VLM_BASE_URL=
ATP_VLM_API_KEY=
ATP_VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct


# ─────────────────────────────────────────────
#  4c. 原图存储  (demo1)
# ─────────────────────────────────────────────
# 从 PDF / DOCX 抽出来的内嵌图片存哪。
#
# 图转文字之后**仍然要留原图**：描述文本是有损的，检索靠描述，
# 但用户点开引用时想确认的是「界面到底长什么样」。
# 所以 payload 里两样都存 —— 描述进 embedding，URL 只用于展示。
#
# base-url 留空则用 root 的 file:// 绝对地址。换成 OSS/S3 时只改这两行，
# 解析和入库代码一行都不用动（payload 里存的始终是 URL 而不是本地路径）。
IMAGE_STORAGE_ROOT=corpus/extracted
IMAGE_STORAGE_BASE_URL=


# ─────────────────────────────────────────────
#  4d. 语料格式  (demo1)
# ─────────────────────────────────────────────
# MARKDOWN / PDF / DOCX。三种格式是**同一份内容**
# （corpus/docs 的 md 由 --atp.task=gen-corpus 生成出 docs-pdf 和 docs-docx），
# 小节标题一致，所以评估集的 golden_ids 三边通用 ——
# 消融表里能加一组「同样的问题、同样的策略，只换语料格式」的单变量对照。
#
# ⚠️ collection 名会带上格式段（atp_docs_heading_pdf），三份数据互不覆盖。
#    MARKDOWN 不加后缀，保持原有 collection 名不变。
CORPUS_FORMAT=MARKDOWN


# ─────────────────────────────────────────────
#  5. Qdrant 向量库  (demo1)
# ─────────────────────────────────────────────
# REST / Web UI 端口（http://${SERVICE_HOST}:6333/dashboard）
# ⚠️ langchain4j-qdrant 走的是 gRPC，端口是 6334 不是 6333。
#    建 collection 的管理操作用 REST（6333）更方便，读写向量走 gRPC（6334）。

# ⚠️ collection 名不在这里写死，而是由 RagConfig 按配置派生：
#     {前缀}_{docs|cases|all}_{fixed|heading}[_{embedding标签}]
#   例：atp_all_fixed（baseline）/ atp_docs_heading / atp_docs_heading_qwen3
#
# 原因：切分策略或 embedding 模型一变，向量就不能复用。若所有配置共用一个
# collection，跑消融表第 2 组会覆盖第 1 组的数据，最后只有末行是真的。


# ─────────────────────────────────────────────
#  5b. 切分参数  (demo1)
# ─────────────────────────────────────────────
# ⚠️ 单位是**字符**不是 token。用字符不是因为拿不到 tokenizer
#   （TEI 有 /tokenize，就是 bge-m3 自己的分词器），而是切分时每块都调一次
#   网络不划算，且在这个语料上精确 token 数不影响任何结果。
#   实测：700 字符 → 中文 399~476 tokens、日文 323~393 tokens。
#
# ⚠️⚠️ 这两个参数在 **HEADING_PATH（主策略）下基本不起作用**：
#   本项目语料的小节 p95 = 407、最长 610 字符，全都短于 700，
#   从来没触发过切分。size 从 700 调到 1200，块数纹丝不动（89 → 89）。
#   而 FIXED（baseline）下会从 41 块掉到 25 块。
#   这不是 bug —— 标题路径策略的本意就是让 chunk 边界由文档结构决定。
#   详见 DECISIONS.md D-017。
CHUNK_SIZE_CHARS=700
CHUNK_OVERLAP_CHARS=80

# 语料目录（相对模块根）
CORPUS_DIR=corpus

# 换 embedding 模型时填，会作为 collection 名后缀把不同向量空间的数据隔离开。
# 用 bge-m3 时留空。消融表第 7 行（Qwen3-Embedding）会用到
EMBEDDING_TAG=


# ─────────────────────────────────────────────
#  6. demo2 MCP Server 运行参数
# ─────────────────────────────────────────────
# STATELESS 适合 k8s 多副本（无 session 亲和性要求）；本项目设计本就无状态

# ── Redis ─────────────────────────────────────────────────────
# 用途：Sa-Token 登录态、agent 多轮工作记忆（AgentScope RedisSession）、
#       agent 中断广播、工具熔断、执行任务队列。
# ⚠️ 向量不存这里 —— 向量在 PG 的 pgvector（AgentScope 的 PgVectorStore 自建表）。
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD=
REDIS_DB=0

# ── 平台 ──────────────────────────────────────────────────────
ATP_PORT=8080
# 启动时导入 seed/ 的 80 条案例与 3 个用户。默认关，用 run-web.sh --seed 开
ATP_SEED_ENABLED=false


# ── 平台 agent 的写侧出口 ───────────────────────────────────────
# 平台内的 agent 与 opencode 走同一个 atp 二进制写案例（格式不漂移）。
# 构建：cd demo2-atp-cli && go build -o bin/atp ./cmd/atp
# 相对路径以**仓库根**为基准，由 run-web.sh 解析成绝对路径后传给 JVM。
ATP_CLI_BIN=demo2-atp-cli/bin/atp
ATP_CLI_TIMEOUT=30

# ── CLI 的窄 token 凭据 ──────────────────────────────────────────
# 平台首次启动时自动创建机器主体 atp-cli，secret 只在日志里打印一次，
# 抄到这里（.env）之后就再也读不到了 —— 库里存的是 hash。
# 权限：case:write / exec:run-once / inspect
# ⚠️ 不含 exec:dispatch —— 派发批次是平台调度权，不发给客户端
ATP_CLIENT_ID=atp-cli
ATP_CLIENT_SECRET=


# 被测系统入口。⚠️ 必须绝对地址；容器里要用宿主机可达的地址，不能是 localhost
MOCK_SHOP_URL=http://localhost:8088

# 三个演示账号（kaneshiro / sato / tanaka）的统一口令。⚠️ 虚构演示数据
ATP_DEMO_PASSWORD=atp-demo-2026

# ── 前端来源白名单 ──────────────────────────────────────────────
# ⚠️ 必须包含正式域名。浏览器对非 GET/HEAD 请求**即使同源也会带 Origin**，
#    而 Spring 的 CorsFilter 只要看到 Origin 就查白名单 —— 不在白名单里就是
#    403 Invalid CORS request，与同不同源无关。
#    实测：域名上线后没加进白名单，https 站点上的登录直接 403。
ATP_CORS_ORIGINS=https://your-domain.example,http://localhost:5173

# ── 执行产物的回传与存放 ─────────────────────────────────────────
# 节点把录像/截图 PUT 到这个平台。⚠️ 必须指向**要播放录像的那个平台实例**，
# 不是节点本机的那个 —— 默认值 localhost:8080 会让录像留在开发机上，
# 而线上平台的 /api/artifacts 是空的（症状：执行记录有 🎬 但点开 404）。
ATP_PLATFORM_URL=http://localhost:8080

# 平台存放产物的目录。⚠️ 容器化部署时必须与挂载的 volume 路径一致，
# 否则录像会落进容器内的临时目录 —— 能上传能播放，但**容器一重启就全没了**。
ATP_ARTIFACT_DIR=/tmp/atp-artifacts
