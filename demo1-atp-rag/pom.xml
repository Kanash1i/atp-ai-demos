<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- ⚠️ Spring Boot 2.7.18 是硬约束，不要升级。
       2.7.x 是**最后一个支持 Java 8** 的 Spring Boot 系列（3.0 起要求 Java 17），
       2.7.18 是 2.7 系列的最后一个版本。

       这和 langchain4j 锁 0.35.0 是同一类约束：ATP 平台是 Java 8 + Spring 4 的
       遗留系统，给它做的模块只能停在各个生态最后一个支持 Java 8 的版本上。
       详见 DECISIONS.md D-014。 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.atp</groupId>
  <artifactId>atp-rag</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>ATP 知识助手 (demo1)</name>
  <description>Spring Boot 2.7 + Java 8 + langchain4j 的 RAG demo，核心交付物是检索优化的消融实验表</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- java.version 是 spring-boot-starter-parent 认的属性，它会据此设置编译器 -->
    <java.version>1.8</java.version>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>

    <!-- ⚠️ 硬约束，不要升级。
         langchain4j-core 0.35.0 字节码 major=52 (Java 8)；
         0.36.0 起为 major=61 (Java 17)，升了就编译不过。
         验证方式见 DECISIONS.md D-001。 -->
    <langchain4j.version>0.35.0</langchain4j.version>
  </properties>

  <dependencies>
    <!-- 不用 web starter：这是个 CLI / 批处理应用，不对外提供 HTTP 端点。
         需要的只是 IoC 容器、配置绑定和日志 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- @ConfigurationProperties 的 IDE 提示与元数据 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>

    <!-- OpenAI 兼容客户端。一份依赖两处用：
         DeepSeek 的生成，和 TEI 的 /v1/embeddings -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-open-ai</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>

    <!-- 走 gRPC (6334)。⚠️ Qdrant server 必须是 1.11.x，见 DECISIONS.md D-002 -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-qdrant</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>

    <!-- jackson 与 slf4j 的版本交给 spring-boot-starter-parent 统一管理。
         M0 那次 slf4j-api 2.x 配 slf4j-simple 1.7 的静默 NOP 问题（D-003），
         换成 starter 之后不复存在 —— 版本一致性由 BOM 保证，不再靠手工 pin -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
