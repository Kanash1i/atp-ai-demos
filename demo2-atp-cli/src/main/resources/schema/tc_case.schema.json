{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atp://schema/tc_case",
  "title": "ATP 测试案例（规范化输出）",
  "description": "ATP 测试案例草稿（agent 产出、atp validate 校验）。字段名与 DB 列名一致（snake_case）。本 schema 只约束【形状】：module_id 的外键有效性与 action↔locator 契约无法用 JSON Schema 表达，见 x-validation-not-covered-here。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_code",
    "title",
    "module_id",
    "priority",
    "author",
    "steps"
  ],
  "x-not-produced-by-this-service": {
    "note": "以下字段不由调用方产出，也不接受调用方指定 —— 它们属于状态机或平台，让 agent 填只会制造假象。",
    "fields": {
      "case_id": "atp draft 时由 CLI 本地生成 UUID（幂等键）",
      "case_type": "atp draft --platform 指定，不放进草稿 JSON —— 一个值只有一个来源",
      "status": "由状态机持有：AI_DRAFT --commit--> DRAFT。调用方无权指定",
      "version": "乐观锁，由 DB 维护",
      "step_id": "落库时生成",
      "created_at": "由 DB 维护",
      "updated_at": "由 CaseStore 每条 UPDATE 显式赋 now()"
    }
  },
  "x-validation-not-covered-here": [
    "module_id 必须存在于 tc_module 字典（外键）—— 防模型编造，见 ForeignKeyResolver",
    "action 与 locator/input_data/expected 的契约 —— 见 Action 枚举，共享契约 §1.3",
    "STD-001/002/003 定位器写法 —— 见 LocatorLinter",
    "STD-008 至少一个断言步骤 —— 跨 steps 的约束",
    "seq 必须为 1..n 连续无跳号 —— 跨 steps 的约束"
  ],
  "properties": {
    "case_code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^ATP-[A-Z]+-[0-9]{4}$",
      "description": "STD-007。4 位序号需全局唯一，由平台分配；本服务只保证形状。"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "module_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "外键 → tc_module.module_id。取值有效性不在本 schema 内校验，见 x-validation-not-covered-here。"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "precondition": {
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "action",
        "wait_strategy",
        "wait_timeout_sec",
        "on_failure"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "从 1 开始连续无跳号。连续性属于跨 steps 约束，不在此校验。"
        },
        "action": {
          "type": "string",
          "enum": [
            "OPEN_URL",
            "CLICK",
            "INPUT",
            "SELECT",
            "ASSERT_TEXT",
            "ASSERT_VISIBLE",
            "ASSERT_NOT_EXIST",
            "WAIT_FOR",
            "SCROLL_TO",
            "SWITCH_FRAME",
            "SWITCH_WINDOW",
            "UPLOAD",
            "SLEEP"
          ],
          "description": "SLEEP 在枚举内是因为存量历史案例中存在，但 STD-004 明令禁止新增 —— 由校验器判 ERROR，不靠 schema 拦。"
        },
        "locator_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "XPATH",
            "CSS",
            "ID",
            "NAME",
            "LINK_TEXT",
            null
          ]
        },
        "locator_value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "input_data": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "expected": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "wait_strategy": {
          "type": "string",
          "enum": [
            "NONE",
            "PRESENCE",
            "VISIBLE",
            "CLICKABLE"
          ],
          "description": "NOT NULL。STD-004 的落地：禁止 SLEEP 硬等，必须声明等待条件。"
        },
        "wait_timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 10
        },
        "on_failure": {
          "type": "string",
          "enum": [
            "ABORT",
            "CONTINUE",
            "RETRY"
          ],
          "default": "ABORT"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    }
  }
}
